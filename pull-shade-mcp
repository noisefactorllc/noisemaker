#!/usr/bin/env python3
"""
Download pre-built shade-mcp from GitHub Releases and vendor selected modules.

SHADE_MCP_TAG names the release to vendor. SHADE_MCP_TARBALL instead names a
local shade-mcp-dist.tar.gz, so shade-mcp's own CI can vendor an unreleased
build and run scripts/test-shade-mcp against it before tagging.
"""
import os
import shutil
import subprocess
import tempfile
import sys

REPO = "noisefactorllc/shade-mcp"
VENDOR_DIR = "vendor/shade-mcp"
ASSET_NAME = "shade-mcp-dist.tar.gz"


def download_release(tag, dest_dir):
    """Download and extract the release tarball."""
    tarball = os.path.join(dest_dir, ASSET_NAME)
    token = os.environ.get("GITHUB_TOKEN")

    # Try gh CLI first, fall back to curl
    try:
        cmd = ["gh", "release", "download", tag, "--repo", REPO,
               "--pattern", ASSET_NAME, "--dir", dest_dir]
        subprocess.run(cmd, check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        print("gh CLI unavailable or failed, falling back to curl...")
        url = f"https://github.com/{REPO}/releases/download/{tag}/{ASSET_NAME}"
        curl_cmd = ["curl", "-fSL", "-o", tarball, url]
        if token:
            curl_cmd[1:1] = ["-H", f"Authorization: Bearer {token}"]
        subprocess.run(curl_cmd, check=True)

    # Extract
    subprocess.run(["tar", "-xzf", tarball, "-C", dest_dir], check=True)
    os.remove(tarball)


def main():
    tag = os.environ.get("SHADE_MCP_TAG")
    tarball = os.environ.get("SHADE_MCP_TARBALL")
    if not tag and not tarball:
        print("SHADE_MCP_TAG (e.g. v0.1.0) or SHADE_MCP_TARBALL is required")
        return 1

    with tempfile.TemporaryDirectory() as tmpdir:
        if tarball:
            print(f"Extracting local shade-mcp build {tarball}...")
            subprocess.run(["tar", "-xzf", tarball, "-C", tmpdir], check=True)
        else:
            print(f"Downloading shade-mcp {tag}...")
            download_release(tag, tmpdir)

        print(f"Copying dist to {VENDOR_DIR}...")

        if os.path.exists(VENDOR_DIR):
            shutil.rmtree(VENDOR_DIR)
        os.makedirs(VENDOR_DIR, exist_ok=True)

        # Copy self-contained entry points (no shared chunks)
        for subdir in ["harness", "ai", "formats", "analysis"]:
            src = os.path.join(tmpdir, subdir)
            if os.path.exists(src):
                shutil.copytree(src, os.path.join(VENDOR_DIR, subdir))
                print(f"  + {subdir}/")

    print("Done!")
    return 0


if __name__ == "__main__":
    sys.exit(main())
