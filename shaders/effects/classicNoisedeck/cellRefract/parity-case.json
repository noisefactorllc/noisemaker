{
    "schemaVersion": 1,
    "effects": [
        "synth/noise",
        "classicNoisedeck/cellRefract"
    ],
    "dsl": "search synth, classicNoisedeck\n\nnoise(seed: 1, scaleX: 50, scaleY: 50).cellRefract().write(o0)\nrender(o0)",
    "surface": "o0",
    "resolution": [
        64,
        64
    ],
    "epsilon": 0,
    "requireColorVariation": true,
    "tiles": {
        "size": [
            32,
            32
        ],
        "renderScale": 2
    }
}
