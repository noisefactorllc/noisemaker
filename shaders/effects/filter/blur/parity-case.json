{
    "schemaVersion": 1,
    "effects": [
        "filter/blur",
        "synth/noise"
    ],
    "dsl": "search synth, filter\nnoise(seed: 1, scaleX: 50, scaleY: 50).blur().write(o0)\nrender(o0)",
    "surface": "o0",
    "resolution": [
        64,
        64
    ],
    "epsilon": 0,
    "requireColorVariation": true,
    "tiles": {
        "size": [
            32,
            32
        ],
        "renderScale": 2
    }
}
