{
    "schemaVersion": 1,
    "effects": [
        "synth3d/noise3d",
        "filter3d/flow3d",
        "render/render3d"
    ],
    "dsl": "search synth3d, filter3d, render\n\nnoise3d(seed: 1).flow3d().render3d().write(o0)\nrender(o0)",
    "surface": "o0",
    "resolution": [
        64,
        64
    ],
    "epsilon": 0,
    "requireColorVariation": true
}
