{
    "schemaVersion": 1,
    "effects": [
        "synth3d/fractal3d",
        "render/renderLit3d"
    ],
    "dsl": "search synth3d, render\n\nfractal3d(volumeSize: x32).renderLit3d().write(o0)\nrender(o0)",
    "surface": "o0",
    "resolution": [
        64,
        64
    ],
    "settleMs": 2000,
    "epsilon": 0,
    "requireColorVariation": true,
    "tiles": {
        "size": [
            32,
            32
        ],
        "renderScale": 2
    }
}
