{
    "schemaVersion": 1,
    "effects": [
        "synth/noise",
        "render/pointsEmit",
        "points/physarum",
        "render/pointsRender"
    ],
    "dsl": "search synth, points, render\n\nnoise(seed: 1).pointsEmit(stateSize: x64).physarum().pointsRender().write(o0)\nrender(o0)",
