{
    "schemaVersion": 1,
    "effects": [
        "render/meshLoader",
        "render/meshRender"
    ],
    "dsl": "search render\n\nmeshLoader().meshRender(offsetX: 0.4, offsetY: -0.3, offsetZ: 0.5, rotateX: 40, rotateY: 30).write(o0)\nrender(o0)",
    "surface": "o0",
    "resolution": [
        64,
        64
    ],
    "settleMs": 2000,
    "epsilon": 0,
    "requireColorVariation": true,
    "meshInputs": [
        {
            "mesh": "mesh0",
            "path": "share/meshes/cube.obj"
        }
    ]
}
