{
  "format": "noisemaker-portable-effect",
  "version": 2,
  "name": "Stray Hair",
  "namespace": "user",
  "func": "strayHair",
  "description": "Stray hair overlay",
  "tags": [
    "noise"
  ],
  "globals": {
    "density": {
      "type": "float",
      "default": 0.5,
      "uniform": "density",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "ui": {
        "label": "density",
        "control": "slider"
      }
    },
    "seed": {
      "type": "int",
      "default": 1,
      "uniform": "seed",
      "min": 1,
      "max": 100,
      "step": 1,
      "ui": {
        "label": "seed",
        "control": "slider"
      }
    },
    "alpha": {
      "type": "float",
      "default": 0.5,
      "uniform": "alpha",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "ui": {
        "label": "alpha",
        "control": "slider"
      }
    }
  },
  "passes": {
    "blend": {
      "program": "strayHairBlend",
      "inputs": {
        "inputTex": "inputTex",
        "overlayTex": "overlayTex"
      },
      "uniforms": {
        "alpha": "alpha"
      },
      "outputs": {
        "fragColor": "outputTex"
      }
    }
  },
  "textures": {
    "overlayTex": {
      "width": "screen",
      "height": "screen",
      "format": "rgba8"
    }
  },
  "defaultProgram": "search filter, synth\n\nperlin(scale: 100)\n  .strayHair(density: 1, alpha: 1)\n  .write(o0)",
  "capabilities": [
    {
      "id": "noisemaker/worm-overlay",
      "version": 1,
      "options": {
        "recipe": {
          "layers": 1,
          "checkEachLayer": false,
          "layerSeed": {
            "multiply": 1000,
            "step": 0,
            "offset": 42
          },
          "densityDefault": 0.5,
          "density": {
            "base": 0.001,
            "scale": 0.004
          },
          "kink": {
            "base": 5,
            "modulus": 45
          },
          "stride": 0.5,
          "strideDeviation": 0.25,
          "duration": {
            "base": 8,
            "modulus": 8
          },
          "behavior": {
            "name": "unruly"
          },
          "flowFreq": {
            "base": 4
          },
          "lineWidth": {
            "minimum": 1,
            "divide": 400
          },
          "color": {
            "random": {
              "scale": 30,
              "offset": 0
            },
            "alpha": 0.666
          }
        }
      },
      "bindings": {
        "parameters": {
          "seed": "seed",
          "density": "density"
        },
        "textures": {
          "overlay": "overlayTex"
        }
      }
    }
  ]
}
