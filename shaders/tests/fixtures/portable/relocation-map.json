            "destination": "package.json"
        },
        "pull-shade-mcp": {
            "destination": "pull-shade-mcp"
        },
        "scripts/strict-reporter.mjs": {
            "reason": "A node:test reporter that failed Portable's run on a skipped test. The relocated tests skip nothing, and test:shaders:portable and test:shaders:portable:gpu fail on any test that does not pass."
        },
        "scripts/test": {
            "reason": "Portable's test entry point, which found an executable location for Playwright's Chromium and ran npm test. Noisemaker's workflow installs Chromium, and the package scripts run the relocated tests."
        },
        "test-3d.mjs": {
            "destination": "shaders/tests/test_portable_viewer_3d.mjs"
        },
        "test-definition.mjs": {
            "destination": "shaders/tests/test_portable_definition.mjs"
        },
        "test-docs.mjs": {
            "destination": "shaders/tests/test_portable_docs.mjs"
        },
        "test-globals.mjs": {
            "reason": "In no script or workflow, and it exits 0 whatever it finds."
        },
        "test-hotreload.mjs": {
            "destination": "shaders/tests/test_portable_viewer_hotreload.mjs"
        },
        "test-mcp-config.mjs": {
            "reason": "Starts Portable's vendored shade-mcp server from Portable's MCP configuration, which is not relocated, and Noisemaker does not vendor the server entry. shade-mcp's authored-DSL smoke takes over its compileEffect and renderEffectFrame calls on the relocated starter effect."
        },
        "test-package.mjs": {
            "destination": "shaders/tests/test_portable_packager.mjs"
        },
        "test-params.mjs": {
            "destination": "shaders/tests/test_portable_viewer_params.mjs"
        },
        "test-runtime.mjs": {
            "reason": "Ran the other suites and failed on an exit other than 0, a SKIP line or a missing completion line. test:shaders:portable and test:shaders:portable:gpu run each relocated test and fail on its exit status, and no relocated test skips."
        },
        "test-viewer.mjs": {
            "destination": "shaders/tests/test_portable_viewer.mjs"
        },
        "test-volume-definition.mjs": {
            "destination": "shaders/tests/test_portable_volume_definition.mjs"
        },
        "test-workspace.mjs": {
            "destination": "shaders/tests/test_portable_workspace.mjs"
        },
        "vendor/shade-mcp/": {
            "destination": "vendor/shade-mcp/"
        },
        "viewer/index.html": {
            "destination": "demo/shaders/package.html"
        },
        "workspace.mjs": {
            "destination": "shaders/portable/workspace.mjs"
        }
    },
    "commands": {
        "npm run dev": {
            "destination": "npm run dev",
            "note": "serves the checkout; open demo/shaders/package.html?package=<package directory URL>"
        },
        "npm run package": {
            "destination": "node scripts/package-portable.mjs"
        },
        "npm test": {
            "destination": "npm run test:shaders:portable && npm run test:shaders:portable:gpu"
        },
        "npm run test:docs": {
            "destination": "node shaders/tests/test_portable_docs.mjs"
        },
        "npm run test:runtime": {
            "destination": "npm run test:shaders:portable && npm run test:shaders:portable:gpu"
        },
        "node test-definition.mjs <effect>": {
            "destination": "node scripts/validate-portable.mjs <package>"
        }
    },
