{
    "source": {
        "repository": "https://github.com/noisefactorllc/portable",
        "sha": "6f211e44a0f2eb4baff1b9ae68893fa3b3554085"
    },
    "paths": {
        ".github/dependabot.yml": {
            "reason": "Portable's dependency updates. Noisemaker's own .github/dependabot.yml updates its dependencies, and Portable's dependencies are not carried: the packager needs no ZIP package, and no relocated tool uses Portable's AI or MCP SDKs."
        },
        ".github/workflows/dependabot-auto-merge.yml": {
            "destination": ".github/workflows/dependabot-auto-merge.yml"
        },
        ".github/workflows/docs.yml": {
            "destination": ".github/workflows/shaders-2x.yml"
        },
        ".github/workflows/pull-shade-mcp.yml": {
            "destination": ".github/workflows/pull-shade-mcp.yml"
        },
        ".github/workflows/release-notify.yml": {
            "reason": "Announces Portable's own releases. Portable stays as it is until it is retired, and the relocated tools are released with Noisemaker, through its existing release process."
        },
        ".github/workflows/test.yml": {
            "destination": ".github/workflows/shaders-2x.yml"
        },
        ".gitignore": {
            "reason": "Portable's ignore list, for its own node_modules and effect.zip. Noisemaker's .gitignore covers its tree."
        },
        ".mcp.json": {
            "reason": "Portable's MCP configuration, which starts its vendored shade-mcp server for test-mcp-config.mjs. It is not relocated: Noisemaker's .mcp.json pins its own shade-mcp, and test-mcp-config.mjs has no destination."
        },
        ".vscode/mcp.json": {
            "reason": "The same MCP configuration for VS Code, not relocated for the same reason as .mcp.json."
        },
        "LICENSE": {
            "destination": "LICENSE"
        },
        "README.md": {
            "reason": "Portable's front page: its quick start, packaging, Noisedeck import and coding-agent notes, for Portable's own repository. The format and authoring content it points to is in the Portable guides under docs/shaders/, the viewer's use in docs/shaders/portable-viewer.rst, and the command-line tools' use in the headers of scripts/validate-portable.mjs and scripts/package-portable.mjs."
        },
        "docs/DSL.md": {
            "destination": "docs/shaders/portable-dsl.rst"
        },
        "docs/FORMAT.md": {
            "destination": "docs/shaders/portable-packages.rst"
        },
        "docs/PARAMETERS.md": {
            "destination": "docs/shaders/portable-parameters.rst"
        },
